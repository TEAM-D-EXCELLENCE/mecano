# ============================================================
# .env.docker – Variables d'environnement pour Docker
# Copier ce fichier vers .env avant de lancer docker compose
# ============================================================

# --- Application -----------------------------------------------
APP_NAME="Mecano API"
APP_ENV=production
APP_KEY=                    # php artisan key:generate --show
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://api.garage.excellenceteam.site   # Votre domaine API

# --- Vitrine publique ------------------------------------------
# Compose les liens canoniques du message WhatsApp.
APP_FRONTEND_URL=https://webgarage.excellenceteam.site

# --- Origines autorisées ---------------------------------------
# Les origines CORS ne sont plus configurables ici : elles vivent dans
# config/cors.php, parce qu'une frontière de sécurité doit passer par une
# relecture de code et non par une variable d'environnement.

# Domaines Sanctum (sans https://)
SANCTUM_STATEFUL_DOMAINS=admin-nine-smoky-13.vercel.app,admin.garage.excellenceteam.site,web-mu-three-85.vercel.app,webgarage.excellenceteam.site

# Webhook de revalidation de la vitrine (les deux sont nécessaires)
FRONTEND_REVALIDATE_URL=https://webgarage.excellenceteam.site/api/revalidate
REVALIDATION_SECRET=changez-moi-en-production

# --- Port exposé par le conteneur sur l'hôte -------------------
API_PORT=8000

# --- Base de données (Supabase PostgreSQL) ---------------------
DB_HOST=aws-1-eu-west-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.VOTRE_PROJECT_REF
DB_PASSWORD=VOTRE_MOT_DE_PASSE
DB_SSLMODE=require

# --- Cloudinary ------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=mecano/cars

# --- remove.bg -------------------------------------------------
REMOVE_BG_API_KEY=

# --- Logs ------------------------------------------------------
LOG_LEVEL=error
